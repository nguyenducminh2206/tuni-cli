{
  "channel": {
    "L": 8,
    "S": 1.0,
    "D": 2.0,
    "dt": 0.01,
    "T": 2.0,
    "runs_per_symbol": 300,
    "seed": 12345,
    "symbols": {
      "0": [30, 70, 0, 0, 0],
      "1": [50, 50, 0, 0, 0],
      "2": [0, 80, 20, 0, 0],
      "3": [0, 90, 10, 0, 0]
    },
    "n_slots": 5,
    "slot_dt": 1.0,
    "budget": 100
  },
  "data": {
    "path": "data/encoder.csv",
    "x_cols": "comp3_0:comp3_200",
    "y_col": "symbol",
    "sequence_mode": "split",
    "balance": false
  },
  "model": {
    "cnn": {
      "type": "cnn",
      "channels": [16, 32],
      "kernel_size": 5,
      "pool": 2,
      "fc": 128,
      "epochs": 15,
      "lr": 0.001,
      "batch_size": 32,
      "device": "auto"
    },
    "mlp": {
      "type": "mlp",
      "hidden_layers": [128, 128],
      "activation": "relu",
      "optimizer": "adam",
      "lr": 0.001,
      "dropout": 0.0,
      "batch_size": 64,
      "epochs": 15
    }
  },
  "train": {
    "test_size": 0.2,
    "random_state": 42,
    "standardize": true
  },
  "output": {
    "dir": "outputs",
    "show_report": true
  }
}
